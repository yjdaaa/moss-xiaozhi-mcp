# =============================================================================
# 配置模板：复制为 .env 后按自己的环境填写
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 真实 token、设备 IP、摄像头密码等敏感信息只放在本机 .env，不要提交到仓库。
# 本仓库所有可选项都有安全默认值；只配置你需要的能力即可。
# =============================================================================

# ---------------------------------------------------------------------------
# MCP 接入（必填）：小智/MOSS 控制台生成的 MCP 接入点
# ---------------------------------------------------------------------------
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=<your-token>

# ---------------------------------------------------------------------------
# 摄像头（可选）：仅在需要视觉识别时启用
# ---------------------------------------------------------------------------
# 是否启用网络摄像头 MCP；没有摄像头保持 false
ENABLED_IP_CAMERA=false
# ONVIF 摄像头 IP
ONVIF_CAMERA_IP=<camera-ip>
# ONVIF 摄像头端口（不同品牌可能不同，如天地伟业为 80）
ONVIF_CAMERA_PORT=80
# ONVIF 摄像头账号
ONVIF_CAMERA_USERNAME=<camera-username>
# ONVIF 摄像头密码
ONVIF_CAMERA_PASSWORD=<camera-password>
# 是否启用 ONVIF 云台控制（带云台的摄像头可开启）
ONVIF_CAMERA_PTZ_ENABLED=false
# 是否启用 ONVIF 识别日志
ONVIF_CAMERA_LOG=false
# 是否启用 ONVIF 截图保存到本地
ONVIF_CAMERA_CAPTURE=false

# ---------------------------------------------------------------------------
# Home Assistant（可选）：该工具当前默认禁用
# ---------------------------------------------------------------------------
HA_ADDRESS=http://<ha-host>:8123
HA_AUTH_TOKEN=<ha-token>

# ---------------------------------------------------------------------------
# 激光雕刻机（可选）：按你的设备填写
# ---------------------------------------------------------------------------
# 默认连接模式：network 或 serial；语音明确说串口/COM/USB 时可覆盖
LASER_DEFAULT_CONNECTION_MODE=network
# 雕刻方式：raster=填充/栅格雕刻（默认）；outline=轮廓/线雕；laser_mode=cut 切割不受此项影响
LASER_ENGRAVING_MODE=raster
# 网络激光机地址：只填 IP 或主机名，不要带 http:// 或路径
LASER_NETWORK_HOST=<laser-host>
LASER_NETWORK_HTTP_PORT=80
LASER_NETWORK_TELNET_PORT=23
# 串口连接参数（serial 模式用）
GRBL_DEFAULT_PORT=COM3
GRBL_BAUDRATE=115200
# 雕刻输出目录：默认 <仓库>/generated，可改成自己的目录
# LASERGRBL_JOB_DIR=
# 激光 Web 控制台：0.0.0.0 仅用于可信局域网手机访问，不要映射公网；只本机用改回 127.0.0.1
LASER_WEB_HOST=127.0.0.1
LASER_WEB_PORT=8766
# 材料参数库文件：本机实测参数统一维护在该文件（默认在仓库根目录）
# LASER_MATERIAL_PARAMS_FILE=.lasergrbl_materials.json
# 默认 G-code / 图片文件路径
# GRBL_DEFAULT_FILE=
# LASERGRBL_DEFAULT_IMAGE=
